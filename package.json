{
  "name": "private_clash_server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "一个基于 Deno 和 Oak 的轻量 Clash 订阅服务。服务从远端 Clash YAML 中读取 `proxies`，原样写入本地 `template.yaml`，再返回完整配置。SS、SSR 等节点的字段不会被重新解析或改写。",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
